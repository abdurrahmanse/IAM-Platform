# ==========================================
# ENTERPRISE IAM PLATFORM - ENVIRONMENT VARIABLES
# ==========================================
# This file is used across the entire Turborepo workspace.
# Both FastAPI (via python-dotenv/Pydantic) and Next.js (via Turborepo)
# can access these variables during development.

# ------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:45683968@localhost:5432/iam_db"
# If running via Docker Compose: 
# DATABASE_URL="postgresql+asyncpg://user:password@db:5432/iam_db"

# ------------------------------------------
# 2. CACHE & SESSIONS (Redis)
# ------------------------------------------
REDIS_URL="redis://localhost:6379/0"
# If running via Docker Compose:
# REDIS_URL="redis://redis:6379/0"

# ------------------------------------------
# 3. BACKEND (FastAPI) CONFIGURATION
# ------------------------------------------
ENVIRONMENT="development"
API_V1_STR="/api/v1"
SECRET_KEY="YOUR_SUPER_SECRET_KEY_PLEASE_CHANGE_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (Comma separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# ------------------------------------------
# 4. FRONTEND (Next.js) PUBLIC VARIABLES
# ------------------------------------------
# Note: Next.js variables must be prefixed with NEXT_PUBLIC_ to be exposed to the browser.
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Internal/Admin App URLs
NEXT_PUBLIC_PORTAL_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3002"

# ------------------------------------------
# 5. THIRD-PARTY INTEGRATIONS (Stubs)
# ------------------------------------------
# Email Service (e.g., SendGrid, AWS SES)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""

# OAuth2 Providers (e.g., Google, Microsoft, GitHub)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
